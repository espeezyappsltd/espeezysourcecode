    "nodemailer": "^8.0.5",
    "openai": "^6.34.0",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "react-is": "^19.2.5",
    "recharts": "^3.8.1",
    "stripe": "^18.5.0",
    "typecheck": "^0.1.2",
    "wrangler": "^4.95.0",
    "zod": "^4.3.6"
