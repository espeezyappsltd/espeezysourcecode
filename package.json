{
  "name": "espeezycodebaseserver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "stop": "taskkill /F /IM node.exe /T || killall node || true",
    "shortcuts": "node ./scripts/seed-shortcuts.mjs",
    "dev:prereg": "npm --prefix apps/prereg run dev",
    "dev:games": "npm --prefix apps/games run dev",
    "dev:dashboard": "npm --prefix apps/dashboard run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:core": "npm --prefix apps/core run dev",
    "dev:all:apps": "npm run dev:prereg ; npm run dev:games ; npm run dev:dashboard ; npm run dev:admin ; npm run dev:core",
    "build": "next build --webpack",
    "build:prereg": "npm --prefix apps/prereg run build",
    "build:games": "npm --prefix apps/games run build",
    "build:dashboard": "npm --prefix apps/dashboard run build",
    "build:admin": "npm --prefix apps/admin run build",
    "build:core": "npm --prefix apps/core run build",
    "start": "node CUSTOMSERVERS/base/customserver.js",
    "start:dashboard": "npm --prefix apps/dashboard run start",
    "start:admin": "npm --prefix apps/admin run start",
    "start:core": "npm --prefix apps/core run start",
    "docker:core:up": "docker compose -f docker-compose.core.local.yml up -d",
    "docker:core:down": "docker compose -f docker-compose.core.local.yml down",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:prereg": "npm --prefix apps/prereg run typecheck",
    "typecheck:games": "npm --prefix apps/games run typecheck",
    "typecheck:dashboard": "npm --prefix apps/dashboard run typecheck",
    "typecheck:admin": "npm --prefix apps/admin run typecheck",
    "test": "playwright test",
    "test:critical": "playwright test tests/critical.spec.ts",
    "deploy:resilient": "bash ./scripts/deploy-resilient.sh",
    "deploy:edge": "bash ./scripts/deploy-resilient.sh --with-edge",
    "deploy:app-only": "bash ./scripts/deploy-resilient.sh --no-edge",
    "predeploy:prereg": "npm --prefix apps/prereg run predeploy:check",
    "predeploy:games": "npm --prefix apps/games run predeploy:check",
    "predeploy:dashboard": "npm --prefix apps/dashboard run predeploy:check",
    "predeploy:admin": "npm --prefix apps/admin run predeploy:check",
    "predeploy:core": "npm --prefix apps/core run predeploy:check",
    "predeploy:apps": "npm run predeploy:prereg ; npm run predeploy:games ; npm run predeploy:dashboard ; npm run predeploy:admin ; npm run predeploy:core"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.2.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^2.0.1",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "country-flag-icons": "^1.6.16",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.12.41",
    "lucide-react": "^1.8.0",
    "next": "^16.2.4",
    "next-intl": "^4.9.1",
    "nodemailer": "^8.0.5",
    "openai": "^6.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^19.2.5",
    "recharts": "^3.8.1",
    "stripe": "^18.5.0",
    "typecheck": "^0.1.2",
    "vercel": "^53.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.5.0",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "supabase": "^2.98.2",
    "typescript": "^5",
    "typescript-eslint": "^8.59.0"
  },
  "overrides": {}
}
