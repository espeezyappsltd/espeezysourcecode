# Firebase Project Keys
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_SERVICE_ACCOUNT_KEY=your_base64_encoded_json_key

# App Configuration
NEXT_PUBLIC_APP_URL=https://espeezy.com

# Local testing override (recommended in .env.local)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth Application Keys (Configure in Supabase Dashboard)
# These are for your reference; Supabase handles the actual exchange.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth Application Keys (For login and API access)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Spotify Integration Keys (Register at developer.spotify.com)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://espeezy.com/api/spotify/callback

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Legacy keys (still used as fallback)
STRIPE_PRICE_SUBSCRIPTION_ID=price_...
STRIPE_PRICE_ONE_TIME_ID=price_...
# Freemium plan price IDs (create these in Stripe Dashboard > Products)
STRIPE_PRICE_PRO_ID=price_...         # Pro Scholar £9/month recurring
STRIPE_PRICE_PREMIUM_ID=price_...     # Premium Scholar £19/month recurring
STRIPE_PRICE_LIFETIME_ID=price_...    # Lifetime Founding Scholar £149 one-time
# Optional fund donation product wiring for /fund.
# STRIPE_FUND_DEFAULT_PRODUCT_ID is used for all donations unless a feature-specific mapping matches the selected fund feature label.
STRIPE_FUND_DEFAULT_PRODUCT_ID=prod_...
STRIPE_FUND_PRODUCT_MAP={"AI Study Coach & Adaptive Learning Engine":"prod_...","LMS Integration Layer (Canvas, Blackboard, Nile)":"prod_..."}
STRIPE_SUCCESS_URL=https://espeezy.com/dashboard/settings?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://espeezy.com/dashboard/settings

# Stripe Connect / P2P payouts
# Platform fee is handled in app logic. Members must have active connected accounts.
STRIPE_CONNECT_CLIENT_ID=ca_...

# SMTP for transactional email receipts (supports username@espeezy.com aliases)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=feedback@espeezy.com
SMTP_PASS=your_mailbox_password
FEEDBACK_EMAIL=feedback@espeezy.com
SUPPORT_EMAIL=support@espeezy.com

# Pre-registration storage (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Legacy aliases still accepted by the prereg route
PROJECT_URL=https://your-project.supabase.co
SECRET_KEY=your-supabase-service-role-key

# Quiz + rewards tuning
QUIZ_DEFAULT_ENTRY_FEE_CENTS=0
QUIZ_MAX_QUESTION_COUNT=20
REWARDS_POINTS_PER_DOLLAR=10

TWILIORECOVERYCODE=VD4VABS9LN3N5NF6WM16MXSE

# AI Agent Orchestration
# Secret key used by automated agent workers to authenticate against the agent task API.
# Set to a long random string (e.g. openssl rand -hex 32). Keep this private.
AGENT_API_KEY=your-agent-api-key-here

# Pre-registration & Security
# IP_HASH_SALT: Random secret used to hash IPs for deduplication without storing raw IPs
# Generate with: openssl rand -hex 32
IP_HASH_SALT=your-random-salt-here
