model Article {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  content        String
  author         String
  published      Boolean  @default(false)
  metaTitle      String?
  metaDescription String?
  metaImage      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
