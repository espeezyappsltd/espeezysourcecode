// Prisma schema for Supabase Postgres

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model marketplace_listings {
  id           String   @id @default(uuid())
  user_id      String
  title        String
  description  String?
  asset_url    String?
  price_cents  Int
  status       String   @default("active")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model account_credits {
  id               String   @id @default(uuid())
  user_id          String
  points           Int      @default(0)
  balance_cents    Int      @default(0)
  stripe_account_id String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}
 

model Article {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  content        String
  author         String
  published      Boolean  @default(false)
  metaTitle      String?
  metaDescription String?
  metaImage      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reactions      Reaction[]
}

model Reaction {
  id         String   @id @default(uuid())
  articleId  String
  userId     String
  type       String // e.g. 'like', 'star', 'comment', 'love', etc.
  createdAt  DateTime @default(now())
  Article    Article  @relation(fields: [articleId], references: [id])
}


model jobs {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("pending")
  client_id   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}
