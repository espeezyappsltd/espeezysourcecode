{
  "name": "espeezy-kanban",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001 --webpack",
    "dev:turbo": "next dev -p 3001",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "build": "next build",
    "vercel-build:panel": "cd ../.. && npm run vercel-build:kanban",
    "start": "npx serve out -p 3001",
    "stop": "npx kill-port 3001",
    "typecheck": "tsc --noEmit",
    "predeploy:check": "npm run typecheck && npm run build",
    "test:e2e": "playwright test --config src/playwright.config.ts",
    "test:e2e:completion": "playwright test src/tests/two-user-project-completion.spec.ts --config src/playwright.config.ts --project=chromium",
    "test:profile-realtime": "node --test src/lib/profile/realtime.node-test.mjs",
    "validate:profile-realtime": "node scripts/validate-profile-realtime.mjs",
    "validate:assets-a11y": "node scripts/validate-assets-a11y.mjs",
    "validate:hustle": "node scripts/validate-hustle.mjs",
    "validate:teams": "node scripts/validate-teams.mjs",
    "test:e2e:assets-a11y": "playwright test src/tests/assets-accessibility.spec.ts --config src/playwright.config.ts --project=chromium"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.5.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jspdf": "^1.3.3",
    "@vercel/analytics": "^1.6.1",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "country-flag-icons": "^1.6.17",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.13.1",
    "lucide-react": "^1.8.0",
    "next": "^16.2.4",
    "next-intl": "^4.12.0",
    "nodemailer": "^8.0.7",
    "@types/nodemailer": "^6.4.17",
    "openai": "^6.37.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "stripe": "^22.1.1",
    "typescript": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.4.1",
    "typescript": "^5"
  }
}
