{
  "name": "espeezy-kanban",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001 --webpack",
    "dev:turbo": "next dev -p 3001",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "build": "next build --webpack",
    "cf-build": "opennextjs-cloudflare build",
    "deploy:cf": "wrangler deploy",
    "preview:cf": "opennextjs-cloudflare preview",
    "start": "npx serve out -p 3001",
    "stop": "node ../../scripts/stop-app-port.mjs 3001",
    "typecheck": "tsc --noEmit",
    "predeploy:check": "npm run typecheck && npm run build",
    "strip:secondary": "node scripts/strip-secondary-features.mjs",
    "test:e2e": "playwright test --config src/playwright.config.ts",
    "test:e2e:ci": "playwright test --config src/playwright.config.ts --project=chromium",
    "test:e2e:completion": "playwright test src/tests/two-user-project-completion.spec.ts --config src/playwright.config.ts --project=chromium",
    "test:profile-realtime": "node --test src/lib/profile/realtime.node-test.mjs",
    "validate:profile-realtime": "node scripts/validate-profile-realtime.mjs",
    "validate:teams": "node scripts/validate-teams.mjs"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.5.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-virtual": "^3.13.24",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "libphonenumber-js": "^1.13.1",
    "lucide-react": "^1.8.0",
    "next": "^16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "stripe": "^22.1.1",
    "typescript": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "wrangler": "^4.95.0"
  }
}
