{
  "name": "espeezy-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build --webpack",
    "cf-build": "opennextjs-cloudflare build",
    "deploy:cf": "wrangler deploy",
    "preview:cf": "opennextjs-cloudflare preview",
    "start": "npx serve out -p 3003",
    "stop": "node ../../scripts/stop-app-port.mjs 3003",
    "typecheck": "tsc --noEmit",
    "predeploy:check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "cmatrix": "^0.5.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "wrangler": "^4.95.0"
  }
}
