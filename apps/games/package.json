{
  "name": "espeezy-games",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build --webpack",
    "cf-build": "opennextjs-cloudflare build",
    "deploy:cf": "wrangler deploy",
    "preview:cf": "opennextjs-cloudflare preview",
    "stop": "node ../../scripts/stop-app-port.mjs 3002",
    "start": "npx serve out -p 3002",
    "typecheck": "tsc --noEmit",
    "predeploy:check": "npm run typecheck && npm run build",
    "seed:catalog": "node ../../scripts/seed-games-catalog.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "test:e2e": "playwright test --config src/playwright.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "wrangler": "^4.103.0"
  }
}
