{
  "name": "espeezy-prereg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "stop": "taskkill /F /IM node.exe /T || killall node || true",
    "build": "next build",
    "vercel-build:prereg": "cd ../.. && npm install && npm run build --prefix apps/prereg",
    "vercel-build:admin": "npm run vercel-build:prereg",
    "start": "npx serve out -p 3001",
    "typecheck": "tsc --noEmit",
    "predeploy:check": "npm run typecheck && npm run build",
    "test:e2e": "playwright test --config src/playwright.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^1.6.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "^16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^12.0.0",
    "typescript": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
