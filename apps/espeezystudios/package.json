{
  "name": "espeezystudios",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3007 --webpack",
    "build": "next build --webpack",
    "cf-build": "opennextjs-cloudflare build",
    "deploy:cf": "wrangler deploy",
    "preview:cf": "opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "echo \"No lint configured for this repo. Install ESLint or configure Next lint if needed.\"",
    "validate:studios": "node scripts/validate-studios.mjs",
    "rsl": "npm run typecheck && npm run validate:studios",
    "stop": "node ../../scripts/stop-app-port.mjs 3007"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "chart.js": "^4.4.1",
    "file-saver": "^2.0.5",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "nodemailer": "^6.10.0",
    "react": "19.2.4",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "wrangler": "^4.95.0"
  }
}
