# ──────────────────────────────────────────────────────────────────────────────
# espeezy.com — Caddyfile
#
# Required env vars (set in .env.local or shell before docker compose up):
#   CADDY_DOMAIN=espeezy.com          — apex domain
#
# Optional:
#   For a raw IP (no domain), set CADDY_DOMAIN to your VPS IP.
#
# Architecture:
#   [User browser]
#       → *.espeezy.com (DNS → VPS IP)
#       → Caddy (ports 80/443, auto-TLS via Let's Encrypt)
#       → Next.js app containers (see docker-compose.local.yml)
# ──────────────────────────────────────────────────────────────────────────────

# ── Shared proxy snippet factory ─────────────────────────────────────────────
# Usage: import app_proxy <container_name> <port>
(app_proxy) {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets {args[0]}:{args[1]}

    reverse_proxy {args[0]}:{args[1]} {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        health_uri /
        health_interval 15s
        health_timeout 5s
    }

    log {
        output file /data/access.log {
            roll_size 20mb
            roll_keep 5
        }
    }
}

# Backwards-compat alias for existing references
(espeezy_proxy) {
    import app_proxy app 3000
}

# ── Apex domain: espeezy.com → marketing (prereg) ────────────────────────────
{$CADDY_DOMAIN}, www.{$CADDY_DOMAIN} {
    @www host www.{$CADDY_DOMAIN}
    redir @www https://{$CADDY_DOMAIN}{uri} 308
    import app_proxy app 3000
}

# ── base.espeezy.com → monorepo dev hub (repo root Next.js) ──────────────────
base.{$CADDY_DOMAIN} {
    import app_proxy app 3000
}

# ── prereg.espeezy.com → pre-registration app ────────────────────────────────
prereg.{$CADDY_DOMAIN} {
    import app_proxy prereg 3001
}

# ── games.espeezy.com → games app ────────────────────────────────────────────
games.{$CADDY_DOMAIN} {
    import app_proxy games 3002
}

# ── kanban.espeezy.com → Kanban Next.js app ──────────────────────────────────
kanban.{$CADDY_DOMAIN} {
    import app_proxy kanban 3003
}

# ── devlaunch.espeezy.com → core / developer launchpad (apps/core) ───────────
devlaunch.{$CADDY_DOMAIN} {
    import app_proxy core 3000
}

# ── core.espeezy.com → legacy alias → devlaunch ──────────────────────────────
core.{$CADDY_DOMAIN} {
    redir https://devlaunch.{$CADDY_DOMAIN}{uri} permanent
}

# ── studios.espeezy.com → Espeezy Studios (marketplace & jobs) ───────────────
studios.{$CADDY_DOMAIN} {
    import app_proxy studios 3000
}

# ── articles.espeezy.com + blog.espeezy.com → articles app ───────────────────
articles.{$CADDY_DOMAIN} {
    import app_proxy articles 3000
}

blog.{$CADDY_DOMAIN} {
    import app_proxy articles 3000
}

# ── planka.espeezy.com → Planka board ────────────────────────────────────────
planka.{$CADDY_DOMAIN} {
    import app_proxy planka 1337
}
